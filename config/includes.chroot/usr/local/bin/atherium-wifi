#!/usr/bin/env bash
set -euo pipefail

# Atherium-X Reliable GUI Wi-Fi Manager (zenity + sudo nmcli)
# Uses sudo nmcli to avoid Polkit/keyring failures in live sessions,
# cleans stale failed profiles before connecting, and verifies IP connectivity.

if ! command -v nmcli >/dev/null 2>&1; then
    zenity --error --title="Atherium Wi-Fi" --text="NetworkManager (nmcli) is not available."
    exit 1
fi

# Unblock Wi-Fi radio if soft-blocked and enable Wi-Fi
sudo rfkill unblock wifi 2>/dev/null || true
sudo nmcli radio wifi on 2>/dev/null || true

# Trigger a fresh scan
(
    echo "30" ; echo "# Scanning nearby Wi-Fi networks..."
    sudo nmcli dev wifi rescan 2>/dev/null || true
    sleep 2
    echo "100" ; echo "# Scan complete."
) | zenity --progress --title="Atherium-X // Wi-Fi Scanner" --auto-close --no-cancel --width=360 || true

# Build deduplicated list of visible networks
ROWS=()
while IFS=: read -r INUSE SSID SIGNAL SEC; do
    [[ -z "${SSID}" ]] && continue
    STATUS="Available"
    [[ "${INUSE}" == "*" ]] && STATUS="Connected"
    [[ -z "${SEC}" ]] && SEC="Open"
    ROWS+=("${STATUS}" "${SSID}" "${SIGNAL}%" "${SEC}")
done < <(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null | awk -F: '!seen[$2]++')

if [[ ${#ROWS[@]} -eq 0 ]]; then
    zenity --warning --title="Atherium-X // Wi-Fi" --width=420 \
        --text="No Wi-Fi networks found.\n\nEnsure Wi-Fi is enabled on your laptop, or connect an Ethernet cable."
    exit 0
fi

SELECTED=$(zenity --list \
    --title="Atherium-X // Wi-Fi Networks" \
    --text="Double-click a Wi-Fi network to connect:" \
    --width=560 --height=420 \
    --column="Status" --column="Network (SSID)" --column="Signal" --column="Security" \
    --print-column=2 \
    "${ROWS[@]}" || true)

[[ -z "${SELECTED}" ]] && exit 0

# Prompt for password (pre-clear stale broken profiles so nmcli never reuses a bad secret)
PASS=$(zenity --password \
    --title="Connect to ${SELECTED}" \
    --text="Enter Wi-Fi password for '${SELECTED}'\n(Leave blank for an open network):" || true)

# Remove any old failed connection profile for this SSID
sudo nmcli connection delete id "${SELECTED}" >/dev/null 2>&1 || true

OUT_FILE=$(mktemp)
trap 'rm -f "${OUT_FILE}"' EXIT

(
    echo "40" ; echo "# Connecting to ${SELECTED}..."
    if [[ -n "${PASS}" ]]; then
        sudo nmcli --wait 20 dev wifi connect "${SELECTED}" password "${PASS}" >"${OUT_FILE}" 2>&1 || echo "__FAIL__" >> "${OUT_FILE}"
    else
        sudo nmcli --wait 20 dev wifi connect "${SELECTED}" >"${OUT_FILE}" 2>&1 || echo "__FAIL__" >> "${OUT_FILE}"
    fi
    echo "100" ; echo "# Done."
) | zenity --progress --title="Atherium-X // Connecting..." --auto-close --no-cancel --width=380 || true

if grep -q "__FAIL__" "${OUT_FILE}"; then
    ERR_MSG=$(grep -v "__FAIL__" "${OUT_FILE}" || true)
    zenity --error --title="Atherium-X // Wi-Fi Error" --width=460 \
        --text="Could not connect to '${SELECTED}'.\n\nDetails:\n${ERR_MSG}"
else
    IP_ADDR=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
    notify-send -i atherium-network "ATHERIUM-X // WI-FI CONNECTED" "Connected to ${SELECTED} (IP: ${IP_ADDR:-assigned})"
fi
