#!/bin/sh
# Atherium-X Openbox Autostart (Stable Desktop + Polkit + Bottom Taskbar)

# Start Polkit authentication agent (required by nm-applet & system dialogs)
if command -v lxpolkit >/dev/null 2>&1; then
    lxpolkit &
fi

# Start desktop manager (reads ~/.config/pcmanfm/default/desktop-items-0.conf for HUD wallpaper + icons)
pcmanfm --desktop --profile default &

# Start compositor (dark glass + smooth fade)
picom --config ~/.config/picom/picom.conf -b &

# Start notification daemon (top-center, clear of Conky)
dunst &

# Start rock-solid Windows-style bottom taskbar (lxpanel)
lxpanel --profile atherium &

# Start NetworkManager tray applet
nm-applet &

# Start right-side JARVIS telemetry HUD
conky -c ~/.config/conky/conky.conf &

# Display greeting banner once HUD is ready
(sleep 1.5 && /usr/local/bin/atherium-greet) &
