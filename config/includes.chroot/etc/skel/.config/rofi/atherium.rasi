* {
    bg:        #060c1ae8;
    bg-card:   #0c182ee0;
    bg-sel:    #0e2f4ff2;
    fg:        #e2e8f0;
    cyan:      #00e5ff;
    cyan-dim:  #38bdf8;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 82%;
    height: 76%;
    location: center;
    background-color: @bg;
    border: 2px solid;
    border-color: @cyan;
    border-radius: 10px;
    padding: 24px;
}

mainbox {
    spacing: 18px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: #0b1324;
    border: 2px solid;
    border-color: @cyan-dim;
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @cyan;
    font: "Hack Bold 12";
}

entry {
    placeholder: "Search apps, browser, store, games, Wi-Fi...";
    placeholder-color: #64748b;
    text-color: #f8fafc;
    font: "DejaVu Sans 12";
}

listview {
    columns: 5;
    lines: 4;
    spacing: 14px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    orientation: vertical;
    padding: 16px 10px;
    spacing: 8px;
    border-radius: 8px;
    background-color: @bg-card;
    border: 1px solid;
    border-color: #162a47;
}

element selected {
    background-color: @bg-sel;
    border: 2px solid;
    border-color: @cyan;
    text-color: @cyan;
}

element-icon {
    size: 52px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "DejaVu Sans 10";
}
