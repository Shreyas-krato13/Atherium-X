#!/bin/sh
set -e

echo "I: Atherium-X: Stripping documentation, manpages, non-English locales, and caches..."

# Keep /usr/share/doc copyright minimal or remove bulky docs/changelogs/examples
find /usr/share/doc -depth -type f ! -name 'copyright' -delete 2>/dev/null || true
find /usr/share/doc -empty -delete 2>/dev/null || true

# Remove man pages, info pages, lintian, and help docs
rm -rf /usr/share/man/* \
       /usr/share/info/* \
       /usr/share/lintian/* \
       /usr/share/linda/* \
       /usr/share/groff/* \
       /usr/share/gtk-doc/* \
       /usr/share/help/*

# Keep only English locales (en, en_US, en_GB, C, locale.alias)
if [ -d /usr/share/locale ]; then
    find /usr/share/locale -mindepth 1 -maxdepth 1 \
        ! -name 'en' \
        ! -name 'en_US*' \
        ! -name 'en_GB*' \
        ! -name 'C' \
        ! -name 'locale.alias' \
        -exec rm -rf {} + 2>/dev/null || true
fi

# Clean apt caches, build logs, backup db files, and temporary files (keep /var/lib/dpkg/status intact for runtime apt!)
apt-get clean
rm -rf /var/cache/apt/archives/*.deb \
       /var/cache/apt/archives/partial/* \
       /var/lib/apt/lists/* \
       /var/cache/debconf/*-old \
       /var/lib/dpkg/*-old \
       /var/log/*.log \
       /var/log/apt/* \
       /tmp/* \
       /var/tmp/*

echo "I: Atherium-X: Bloat stripping complete."
